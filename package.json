{
  "name": "splittrip",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:emulator": "firebase emulators:exec --config firebase.emulator.json --only auth,firestore,functions --project demo-splittrip-flutter \"vitest run --config vitest.legacy.config.ts\"",
    "test:browser": "playwright test",
    "emulators": "firebase emulators:start --config firebase.emulator.json --only auth,firestore,functions --project demo-splittrip-flutter",
    "seed": "node functions/scripts/seed.cjs",
    "local": "npm start",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "build:local": "npm run build",
    "test:engines": "playwright test --config playwright.engines.config.ts",
    "build:android": "node android/prepare-web.mjs live",
    "build:android:local": "node android/prepare-web.mjs local",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build:emulator": "tsc --noEmit && vite build --mode emulator --outDir dist-emulator",
    "preview:emulator": "vite preview --mode emulator --outDir dist-emulator --host 127.0.0.1 --port 4175 --strictPort",
    "demo": "npm run build:emulator && npm --prefix functions run build && node scripts/demo.mjs",
    "demo:client": "npm run seed && npm run preview:emulator",
    "firebase:android": "node android/connect-firebase.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/push-notifications": "^7.0.7",
    "@ionic/react": "^9.0.4",
    "@ionic/react-router": "^9.0.4",
    "firebase": "^12.0.0",
    "ionicons": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0"
  }
}
